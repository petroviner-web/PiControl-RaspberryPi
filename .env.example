# Run GUI on desktop. Replace with Raspberry Pi's trusted local IP if using LAN.
PICONTROL_HOST=127.0.0.1
PICONTROL_PORT=8765
# Raspberry Pi server bind: 127.0.0.1 by default (suitable for SSH tunnel).
PICONTROL_BIND=127.0.0.1
# For LAN bind supply a random secret at least 24 characters long; never commit it.
PICONTROL_TOKEN=
